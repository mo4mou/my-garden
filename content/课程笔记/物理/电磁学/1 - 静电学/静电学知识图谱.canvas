{
	"nodes":[
		{"id":"n-summary","type":"text","text":"## 静电学公式汇总\n\n库仑定律 → 电场强度 → 高斯定理/环路定理 → 电势 → 泊松方程 → 静电能","x":460,"y":0,"width":380,"height":120},
		{"id":"n-coulomb","type":"text","text":"**库仑定律**\n\n$$\\vec{F}_{12} = \\frac{1}{4\\pi\\varepsilon_0}\\frac{q_1q_2}{r^2}\\hat{r}_{12}$$","x":50,"y":180,"width":320,"height":140},
		{"id":"n-superposition","type":"text","text":"**叠加原理**\n\n$$\\vec{F} = \\sum\\vec{F}_i$$\n\n$$\\vec{F} = \\iiint\\frac{dq}{4\\pi\\varepsilon_0 r^2}\\hat{r}$$","x":340,"y":180,"width":340,"height":170},
		{"id":"n-e-field","type":"text","text":"**电场强度**\n\n$$\\vec{E} = \\frac{\\vec{F}}{q}$$\n\n点电荷：$$\\vec{E} = \\frac{1}{4\\pi\\varepsilon_0}\\frac{q}{r^2}\\hat{r}$$","x":630,"y":180,"width":340,"height":170},
		{"id":"n-flux","type":"text","text":"**电通量**\n\n$$\\Phi = \\iint_S \\vec{E}\\cdot d\\vec{S}$$","x":50,"y":440,"width":260,"height":140},
		{"id":"n-gauss","type":"text","text":"**高斯定理**\n\n$$\\oint_S \\vec{E}\\cdot d\\vec{S} = \\frac{\\sum q}{\\varepsilon_0}$$\n\n$$\\nabla\\cdot\\vec{E} = \\frac{\\rho}{\\varepsilon_0}$$","x":340,"y":430,"width":310,"height":190},
		{"id":"n-loop","type":"text","text":"**电场环路定理**\n\n$$\\oint \\vec{E}\\cdot d\\vec{l} = 0$$\n\n$$\\nabla\\times\\vec{E} = 0$$","x":630,"y":430,"width":300,"height":190},
		{"id":"n-potential","type":"text","text":"**电势**\n\n$$\\varphi = -\\int_{r_0}^r \\vec{E}\\cdot d\\vec{l}$$\n\n$$\\vec{E} = -\\nabla\\varphi$$","x":920,"y":430,"width":300,"height":190},
		{"id":"n-potential-dist","type":"text","text":"**电势分布**\n\n$$\\varphi = \\iiint\\frac{dq}{4\\pi\\varepsilon_0 r}$$","x":630,"y":700,"width":260,"height":140},
		{"id":"n-potential-energy","type":"text","text":"**电势能**\n\n$$E_p = q\\varphi$$\n\n$$W_{ab} = q(\\varphi_a - \\varphi_b)$$","x":920,"y":700,"width":300,"height":180},
		{"id":"n-poisson","type":"text","text":"**泊松方程**\n\n$$\\nabla^2\\varphi + \\frac{\\rho}{\\varepsilon_0} = 0$$","x":340,"y":700,"width":260,"height":140},
		{"id":"n-dipole","type":"text","text":"**电偶极子**\n\n$$\\vec{p} = q\\vec{l}$$\n\n$$\\varphi = \\frac{\\vec{p}\\cdot\\hat{r}}{4\\pi\\varepsilon_0 r^2}$$","x":50,"y":980,"width":300,"height":170},
		{"id":"n-electro-energy","type":"text","text":"**静电能**\n\n$$W = \\frac{1}{2}\\sum q_i\\varphi_i$$\n\n$$w = \\frac{1}{2}\\varepsilon_0 E^2$$","x":630,"y":980,"width":260,"height":170},
		{"id":"n-e-dist","type":"text","text":"**电场分布**\n\n点电荷：$$E = \\frac{q}{4\\pi\\varepsilon_0 r^2}$$\n\n导线：$$E = \\frac{\\lambda}{2\\pi\\varepsilon_0 r}$$\n\n平面：$$E = \\frac{\\sigma}{2\\varepsilon_0}$$","x":50,"y":700,"width":260,"height":200}
	],
	"edges":[
		{"id":"e1","fromNode":"n-coulomb","fromSide":"right","toNode":"n-superposition","toSide":"left","label":"实验基础"},
		{"id":"e2","fromNode":"n-coulomb","fromSide":"bottom","toNode":"n-e-field","toSide":"top","label":"E = F/q"},
		{"id":"e3","fromNode":"n-superposition","fromSide":"bottom","toNode":"n-e-field","toSide":"top","label":"E = ΣEᵢ"},
		{"id":"e4","fromNode":"n-e-field","fromSide":"left","toNode":"n-flux","toSide":"top","label":"Φ = ∮E·dS"},
		{"id":"e5","fromNode":"n-flux","fromSide":"bottom","toNode":"n-gauss","toSide":"top","label":"通量→源"},
		{"id":"e6","fromNode":"n-e-field","fromSide":"bottom","toNode":"n-loop","toSide":"top","label":"∮E·dl = 0"},
		{"id":"e7","fromNode":"n-loop","fromSide":"bottom","toNode":"n-potential","toSide":"top","label":"φ = -∫E·dl"},
		{"id":"e8","fromNode":"n-gauss","fromSide":"right","toNode":"n-loop","toSide":"left","label":"有源∥无旋"},
		{"id":"e9","fromNode":"n-gauss","fromSide":"bottom","toNode":"n-poisson","toSide":"top","label":"∇·E → ∇²φ"},
		{"id":"e10","fromNode":"n-potential","fromSide":"bottom","toNode":"n-potential-dist","toSide":"top","label":"叠加法求φ"},
		{"id":"e11","fromNode":"n-potential","fromSide":"bottom","toNode":"n-potential-energy","toSide":"top","label":"E_p = qφ"},
		{"id":"e12","fromNode":"n-potential-energy","fromSide":"bottom","toNode":"n-electro-energy","toSide":"top","label":"W = ½∑q_iφ_i"},
		{"id":"e13","fromNode":"n-gauss","fromSide":"left","toNode":"n-e-dist","toSide":"top","label":"对称性→E"},
		{"id":"e14","fromNode":"n-e-field","fromSide":"right","toNode":"n-e-dist","toSide":"right","label":"E 的分布"},
		{"id":"e15","fromNode":"n-potential","fromSide":"left","toNode":"n-e-dist","toSide":"bottom","label":"E = -∇φ"}
